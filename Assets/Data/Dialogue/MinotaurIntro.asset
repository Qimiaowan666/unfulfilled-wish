  lines:
  - speaker: "\uFF1F\uFF1F\uFF1F"
    text: "\uFF08\u6C89\u91CD\u7684\u811A\u6B65\u58F0\uFF0C\u4ECE\u795E\u6BBF\u6DF1\u5904\u7684\u9ED1\u6697\u4E2D\u4F20\u6765\u2026\u2026\uFF09"
  - speaker: "\uFF1F\uFF1F\uFF1F"
    text: "\u6E3A\u5C0F\u7684\u751F\u7075\u2026\u2026\u7ADF\u6562\u72EC\u81EA\u8E0F\u5165\u6211\u7684\u795E\u6BBF\u3002"
  - speaker: "\uFF1F\uFF1F\uFF1F"
    text: "\u90A3\u5C31\u628A\u4F60\u7684\u9AB8\u9AA8\uFF0C\u7559\u5728\u8FD9\u7247\u5E9F\u589F\u91CC\u5427\u3002"
